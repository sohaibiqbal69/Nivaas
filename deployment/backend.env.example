# Configure these in the backend host's secret/environment settings.
NODE_ENV=production
# The host injects PORT; do not pin it unless the host explicitly requires it.
MONGODB_URI=
CORS_ORIGIN=https://your-vercel-domain.example
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
# Absolute maximum browser login session lifetime (30 days); access tokens renew within it.
AUTH_REFRESH_SESSION_TTL_SECONDS=2592000

# Initial System Admin is provisioned by a one-shot interactive CLI, never
# through an HTTP endpoint. Inject these two values only for that command,
# use a fresh random secret of at least 32 bytes, then remove them immediately.
# The long-running API refuses to start while bootstrap is enabled.
# NIVAAS_INITIAL_ADMIN_BOOTSTRAP_ENABLED=true
# NIVAAS_INITIAL_ADMIN_BOOTSTRAP_SECRET=
# Routine manager/member setup credential delivery remains unavailable.

# Private Cloudinary delivery for production evidence. These values are
# backend-only and must never be set as Vite/Vercel frontend variables.
EVIDENCE_STORAGE_PROVIDER=cloudinary
EVIDENCE_CLOUDINARY_CLOUD_NAME=
EVIDENCE_CLOUDINARY_API_KEY=
EVIDENCE_CLOUDINARY_API_SECRET=

# Optional compatibility for evidence documents created before the provider
# discriminator was added. Configure only when the existing database needs it.
# EVIDENCE_LEGACY_STORAGE_PROVIDER=s3
# EVIDENCE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# EVIDENCE_S3_BUCKET=nivaas-college-demo-evidence
# EVIDENCE_S3_REGION=auto
# EVIDENCE_S3_ACCESS_KEY_ID=
# EVIDENCE_S3_SECRET_ACCESS_KEY=

# Public-testnet proof integration is not supported by the current backend.
# Its client validates chain 31337 and a loopback Hardhat RPC. Keep these unset
# until the network and signer-custody decisions and implementation are approved.
# BLOCKCHAIN_RPC_URL=
# BLOCKCHAIN_CHAIN_ID=
# BLOCKCHAIN_CONTRACT_ADDRESS=
# BLOCKCHAIN_DEPLOYMENT_TRANSACTION_HASH=
# BLOCKCHAIN_DEPLOYMENT_BLOCK=
# BLOCKCHAIN_SIGNER_PRIVATE_KEY=

