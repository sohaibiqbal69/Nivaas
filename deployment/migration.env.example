# Operator-only values for the explicitly invoked production migration command.
# Do not attach these variables to the long-running backend service.
# Supply MONGODB_URI from the approved secret store or operator shell only.
# MONGODB_URI=<Atlas URI with the exact database name and TLS enabled>
NIVAAS_MIGRATION_DATABASE_NAME=nivaas_college_demo_2026
NIVAAS_MIGRATION_ALLOWED_DATABASES=nivaas_college_demo_2026
