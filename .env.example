# Backend development settings
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/nivaas
# Transaction-capable integration tests only; keep this on the dedicated test database.
# Start the local Docker Compose MongoDB replica set (rs0) before using this URI.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/nivaas_test?replicaSet=rs0
CORS_ORIGIN=http://localhost:5173

# Required to use authentication. Generate a unique random secret of at least 32 characters.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Blockchain values are intentionally unset until an approved integration exists.
# HARDHAT_NETWORK=localhost
