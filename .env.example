# Backend development settings
PORT=4000
# Normal development uses MongoDB Atlas. Put the private connection string in
# the ignored root .env file; never commit it or paste it into chat.
MONGODB_URI=
# Optional local MongoDB mode (Docker is not required for normal development):
# MONGODB_URI=mongodb://127.0.0.1:27017/nivaas?replicaSet=rs0
# Integration tests require a separate disposable database. Do not point this
# at nivaas, nivaas_demo, or nivaas_test; see the test safety documentation.
# Create a fresh loopback database name for each destructive integration run
# and set both variables to that exact name/URI before opting in.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/nivaas_disposable_<unique>?replicaSet=rs0
MONGODB_TEST_URI=
NIVAAS_DISPOSABLE_DATABASE=
CORS_ORIGIN=http://localhost:5173

# Required to use authentication. Generate a unique random secret of at least 32 characters.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_SESSION_TTL_SECONDS=2592000

# Backend-only evidence storage settings. Never expose through VITE_* variables.
EVIDENCE_STORAGE_PROVIDER=local
# Production deployments set provider=cloudinary and configure these only in
# the backend host secret store, not in the frontend/Vercel build environment.
# EVIDENCE_STORAGE_PROVIDER=cloudinary
# EVIDENCE_CLOUDINARY_CLOUD_NAME=
# EVIDENCE_CLOUDINARY_API_KEY=
# EVIDENCE_CLOUDINARY_API_SECRET=
# Optional fallback for older untagged records: local or s3.
# EVIDENCE_LEGACY_STORAGE_PROVIDER=local

# Keep false for normal UI/backend development. Set true only to run the local
# Hardhat chain and deploy GovernanceProofRegistry for local proof work.
NIVAAS_DEV_BLOCKCHAIN_ENABLED=false

# Blockchain proof signer settings belong in the ignored backend/.env file.
# See backend/.env.example; never expose its signer key through a VITE_ variable.
