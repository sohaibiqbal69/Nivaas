{
  "name": "@nivaas/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "e2e:auth-server": "tsx ../tests/e2e/session-auth-server.ts",
    "bootstrap:local-admin": "tsx src/modules/users/local-bootstrap-cli.ts",
    "bootstrap:initial-admin": "tsx src/modules/users/initial-admin-bootstrap-cli.ts",
    "migrate:building-code-index": "tsx scripts/migrate-building-code-index.ts",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run --exclude '**/integration/**' --passWithNoTests",
    "test:integration": "vitest run --no-file-parallelism tests/integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "canonicalize": "5.1.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "jose": "^6.2.12",
    "mongoose": "^8.18.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "vitest": "^4.1.12"
  }
}
