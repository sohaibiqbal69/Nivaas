# Local Hardhat backend proof signer and deployment identity. Copy into the
# ignored backend/.env for development and fill from a local deployment record.
# Integration tests are currently blocked: their helper clears every
# collection in nivaas_test. Keep this empty until the helper requires a
# disposable database and rejects nivaas, nivaas_test, and nivaas_demo.
MONGODB_TEST_URI=
# BLOCKCHAIN_SIGNER_PRIVATE_KEY must be the first Hardhat development account
# used as the registry submitter. Never use that development key outside a
# disposable local chain or expose it to frontend configuration.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_DEPLOYMENT_TRANSACTION_HASH=
BLOCKCHAIN_DEPLOYMENT_BLOCK=
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
NIVAAS_DEV_BLOCKCHAIN_ENABLED=false

# Local onboarding is opt-in and restricted to loopback MongoDB database
# nivaas_demo. Never enable these settings in production.
NIVAAS_LOCAL_BOOTSTRAP_ENABLED=false
NIVAAS_LOCAL_BOOTSTRAP_SECRET=
NIVAAS_LOCAL_SETUP_DELIVERY_ENABLED=false

# Evidence defaults to private local storage outside production. New production
# deployments should use authenticated Cloudinary delivery. Keep all credentials
# in backend-only environment variables; never use VITE_* names.
EVIDENCE_STORAGE_PROVIDER=local
# EVIDENCE_STORAGE_PROVIDER=cloudinary
# EVIDENCE_CLOUDINARY_CLOUD_NAME=
# EVIDENCE_CLOUDINARY_API_KEY=
# EVIDENCE_CLOUDINARY_API_SECRET=
# For a database with older untagged S3 references, retain S3 config and set:
# EVIDENCE_LEGACY_STORAGE_PROVIDER=s3
# EVIDENCE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# EVIDENCE_S3_BUCKET=nivaas-private-evidence
# EVIDENCE_S3_REGION=auto
# EVIDENCE_S3_ACCESS_KEY_ID=
# EVIDENCE_S3_SECRET_ACCESS_KEY=

# Production first-admin bootstrap is CLI-only. See docs/DEPLOYMENT.md.
# NIVAAS_INITIAL_ADMIN_BOOTSTRAP_ENABLED=false
# NIVAAS_INITIAL_ADMIN_BOOTSTRAP_SECRET=
